@{
    ViewData["Title"] = "Public Site";
}
<div class="public-hero">
    <div class="public-hero-card">
        <div class="public-hero-copy">
            <!-- Public site content -->
            <span class="public-pill">Public View</span>
            <h1 class="public-title">Mini-CMS Public Site</h1>
            <p class="public-subtitle">This is the public-facing area for Mini-CMS.</p>
            <div class="public-actions">
                <!-- Links to admin articles and swagger for easy access -->
                <a asp-controller="AdminArticles" asp-action="Index" class="public-btn public-btn-primary">Go to Admin
                    Articles</a>
                    <a href="/swagger" target="_blank" class="public-btn public-btn-secondary">Open Swagger</a>
                </div>
            </div>
        </div>
    </div>