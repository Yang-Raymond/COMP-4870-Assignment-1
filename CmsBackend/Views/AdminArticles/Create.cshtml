@model CmsBackend.Models.Article
@{
    ViewData["Title"] = "Create Article";
}
@section Styles {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
}
<div class="admin-form-shell">
    <a asp-action="Index" class="admin-back-link">← Back to Manage</a>
    <section class="admin-editor-card">
        <div class="admin-editor-header">
            <div>
                <h1 class="admin-editor-title">Create New Article</h1>
                <p class="admin-editor-subtitle">Write a new post for the Mini-CMS admin site.</p>
            </div>
        </div>
        <form method="post" asp-action="Create" asp-controller="AdminArticles" class="admin-editor-form">
            <input type="hidden" asp-for="AuthorId" value="" />
            <div class="admin-field">
                <label asp-for="Title" class="admin-field-label">Article Title</label>
                <input asp-for="Title" class="admin-input" placeholder="Enter title..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="ContentHtml" class="admin-field-label">Content</label>
                <p class="admin-field-help">Content is sanitized before saving.</p>
                <div id="editor-container" class="admin-quill-surface"></div>
                <input type="hidden" asp-for="ContentHtml" id="hiddenContentHtml" />
                <span asp-validation-for="ContentHtml" class="text-danger"></span>
            </div>
            <div class="admin-editor-actions">
                <button type="submit" class="admin-btn-solid">Create Article</button>
                <a asp-controller="AdminArticles" asp-action="Index" class="admin-btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>
@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        var quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Write your article content here...',
        modules: {
        toolbar: [
        [{ 'header': [1, 2, 3, false] }],
        ['bold', 'italic', 'underline'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        ['link', 'image', 'clean']
        ]
        }
        });
        var hiddenInput = document.getElementById('hiddenContentHtml');
        quill.on('text-change', function () {
        var html = quill.root.innerHTML;
        hiddenInput.value = html === '<p><br></p>' ? '' : html;
        });
        document.querySelector('form').addEventListener('submit', function (e) {
        var content = quill.root.innerHTML;
        if (!content || content === '<p><br></p>') {
        e.preventDefault();
        alert('Please enter some content before creating the article.');
        }
        });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}