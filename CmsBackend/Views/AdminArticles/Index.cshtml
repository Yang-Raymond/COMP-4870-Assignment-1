@model List<CmsBackend.Models.Article>

@{
    ViewData["Title"] = "Manage Articles";
}

<script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
<script>
    tailwind.config = {
    darkMode: "class",
    important: '.admin-articles-page',
    corePlugins: { preflight: false },
    theme: {
    extend: {
    colors: {
    primary: "#8b5cf6",
    "primary-hover": "#7c3aed",
    "surface-1": "#16213a",
    "surface-2": "#1d2845",
    "border-soft": "rgba(148, 163, 184, 0.22)",
    "text-main": "#e5eefc",
    "text-soft": "#9fb0cc"
    },
    fontFamily: { display: ["Inter", "sans-serif"], sans: ["Inter", "sans-serif"] },
    boxShadow: { soft: '0 18px 45px rgba(0, 0, 0, 0.20)' }
    },
    },
    };
</script>
<style>
    .admin-articles-page * {
    font-family: 'Inter', sans-serif;
    }
</style>

<div class="admin-articles-page">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full space-y-6">
        <section class="rounded-3xl border p-6 md:p-8 shadow-soft"
                 style="border-color: rgba(148, 163, 184, 0.22); background: #16213a;">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
                <div>
                    <h1 class="text-3xl font-bold text-text-main mb-1">Manage Articles</h1>
                    <p class="text-text-soft text-sm">Create, edit, or delete articles. Admins can manage all content.
                    </p>
                </div>
            </div>
            <div class="relative w-full max-w-xl overflow-hidden">
                <input id="searchInput"
                       class="block w-full max-w-full box-border px-4 py-3 border rounded-xl leading-5 text-text-main placeholder-text-soft focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary sm:text-sm transition-colors"
                       style="background: #1d2845; border-color: rgba(148, 163, 184, 0.22);" placeholder="Search by title"
                       type="text" />
            </div>
            <div class="mt-4 flex justify-between items-center gap-4 flex-wrap">
                <span id="articleCount"
                      class="text-xs font-semibold px-3 py-1.5 rounded-full bg-violet-500/15 text-violet-200 border border-violet-400/25">@Model.Count
                    article@(Model.Count != 1 ? "s" : "") found</span>
                    <div class="flex items-center space-x-2 text-sm text-text-soft">
                        <span>Sort by:</span>
                        <select id="sortSelect"
                                class="text-sm py-2 pl-3 pr-8 rounded-xl border font-medium text-text-main cursor-pointer focus:ring-1 focus:ring-primary focus:border-primary"
                                style="background: #1d2845; border-color: rgba(148, 163, 184, 0.22);">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="title">Title A-Z</option>
                        </select>
                    </div>
                </div>
            </section>

            @if (Model.Count == 0)
            {
                <section class="rounded-3xl border p-8 shadow-soft text-center"
                         style="border-color: rgba(148, 163, 184, 0.22); background: #16213a;">
                    <span class="material-icons text-5xl text-text-soft mb-3 block">article</span>
                    <p class="text-text-soft text-sm">No articles found.</p>
                    <a asp-controller="AdminArticles" asp-action="Create"
                           class="inline-flex items-center justify-center mt-4 px-4 py-2 bg-primary hover:bg-primary-hover text-white text-sm font-medium rounded-xl text-decoration-none transition-colors">Create
                        your first article</a>
                    </section>
                }
        else
                {
                    <div id="articlesGrid" class="space-y-4">
                        @foreach (var article in Model)
                        {
                            <article class="article-card rounded-3xl border p-6 shadow-soft transition-all duration-200"
                                     style="border-color: rgba(148, 163, 184, 0.22); background: #1d2845;"
                                     data-title="@article.Title.ToLowerInvariant()" data-created="@article.CreatedAtUtc.Ticks">
                                <div class="flex items-start justify-between gap-4 flex-wrap">
                                    <div>
                                        <h2 class="text-2xl font-semibold text-text-main mb-2">@article.Title</h2>
                                        <p class="text-sm text-text-soft mb-0">By @(article.Author?.Email ?? "Unknown author") <span
                                            class="mx-2">•</span> @article.CreatedAtUtc.ToString("yyyy-MM-dd, h:mm tt")</p>
                                        </div>
                                        <div class="flex gap-2 flex-wrap">
                                            <a asp-controller="AdminArticles" asp-action="Edit" asp-route-id="@article.Id"
                                               class="inline-flex items-center px-4 py-2 rounded-xl bg-violet-500/15 border border-violet-400/25 text-violet-100 text-sm font-medium text-decoration-none hover:bg-violet-500/25 transition-colors">Edit</a>
                                            <form asp-controller="AdminArticles" asp-action="Delete" asp-route-id="@article.Id"
                                                  method="post" class="m-0" onsubmit="return confirm('Delete this article?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="inline-flex items-center px-4 py-2 rounded-xl bg-red-500/10 border border-red-400/20 text-red-200 text-sm font-medium hover:bg-red-500/20 transition-colors">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                const searchInput = document.getElementById('searchInput');
                const sortSelect = document.getElementById('sortSelect');
                const grid = document.getElementById('articlesGrid');
                const count = document.getElementById('articleCount');
                if (!grid) return;
                const cards = Array.from(grid.querySelectorAll('.article-card'));
                function updateCards() {
                const term = (searchInput?.value || '').trim().toLowerCase();
                const sort = sortSelect?.value || 'newest';
                let visible = cards.filter(card => {
                const matches = card.dataset.title.includes(term);
                card.style.display = matches ? '' : 'none';
                return matches;
                });
                visible.sort((a, b) => {
                if (sort === 'oldest') return Number(a.dataset.created) - Number(b.dataset.created);
                if (sort === 'title') return a.dataset.title.localeCompare(b.dataset.title);
                return Number(b.dataset.created) - Number(a.dataset.created);
                });
                visible.forEach(card => grid.appendChild(card));
                count.textContent = `${visible.length} article${visible.length !== 1 ? 's' : ''} found`;
                }
                searchInput?.addEventListener('input', updateCards);
                sortSelect?.addEventListener('change', updateCards);
                updateCards();
                });
            </script>