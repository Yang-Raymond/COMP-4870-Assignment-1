@model List<CmsBackend.Models.Article>

@{
    ViewData["Title"] = "Manage Articles";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Manage Articles</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "AdminArticles")" class="btn btn-primary">+ New Article</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No articles found. <a href="@Url.Action("Create", "AdminArticles")">Create one</a></div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model)
                {
                    <tr>
                        <td>@article.Title</td>
                        <td>@article.AuthorName</td>
                        <td>@article.CreatedAtUtc.ToString("g")</td>
                        <td>@article.UpdatedAtUtc.ToString("g")</td>
                        <td>
                            <a href="@Url.Action("Edit", "AdminArticles", new { id = article.Id })" class="btn btn-sm btn-warning">Edit</a>
                            <form method="post" action="@Url.Action("Delete", "AdminArticles", new { id = article.Id })" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this article?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
