@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Helper function to determine active nav link
    string AdminNavClass(string controller, string action = "")
    {
        var isActive = currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(action) || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase));

        return isActive ? "admin-link admin-link-active" : "admin-link";
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini-CMS</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="admin-body">
    <header class="admin-topbar">
        <div class="admin-brand">
            <img class="admin-logo-img" src="~/images/penguin.png" alt="Mini-CMS" />
            <div class="admin-brand-text">
                <div class="admin-title">Mini-CMS</div>
                <div class="admin-subtitle">Manage articles and verify backend routes</div>
            </div>
            <span class="admin-badge">ADMIN</span>
        </div>

        <nav class="admin-nav">
            <a asp-controller="AdminArticles" asp-action="Index" class="@AdminNavClass("AdminArticles", "Index")">Manage
                Articles</a>
                <a asp-controller="AdminArticles" asp-action="Create"
                   class="@AdminNavClass("AdminArticles", "Create")">Create Article</a>
                <a href="/swagger" target="_blank" class="admin-link">Swagger</a>
                <a asp-controller="Home" asp-action="Index"
                       class="@(currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "admin-link admin-link-active" : "admin-link")">Public
                    Site</a>
                </nav>

                <div class="admin-auth">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <span class="admin-user">@User.Identity?.Name</span>
                        <form class="admin-logout" asp-area="Identity" asp-page="/Account/Logout" method="post">
                            <button type="submit" class="admin-btn admin-btn-ghost">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="admin-btn admin-btn-ghost" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    }
                </div>
            </header>

            <main class="admin-container">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <span>© @DateTime.Now.Year Mini-CMS</span>
                <a asp-controller="Home" asp-action="Privacy" class="admin-footer-link">Privacy</a>
            </footer>

            @RenderSection("Scripts", required: false)
        </body>

    </html>