@page
@model LoginModel

@{
    ViewData["Title"] = "Admin Login";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="admin-shell">
    <div class="admin-editor-page" style="max-width: 720px; margin: 0 auto;">
        <div class="admin-editor-card">
            <div class="admin-editor-header">
                <h1 class="admin-editor-title">Admin Login</h1>
                <p class="admin-editor-subtitle">
                    Welcome back. Enter your credentials to manage content.
                </p>
            </div>

            <form id="account" method="post" class="admin-editor-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="admin-field">
                    <label asp-for="Input.Email" class="admin-field-label"></label>
                    <input asp-for="Input.Email" class="admin-input" autocomplete="username" aria-required="true"
                           placeholder="Email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="Input.Password" class="admin-field-label"></label>
                    <input asp-for="Input.Password" class="admin-input" autocomplete="current-password"
                           aria-required="true" placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="admin-checkbox-row">
                    <input asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="admin-checkbox-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <div class="admin-editor-actions">
                    <button id="login-submit" type="submit" class="admin-btn-solid">
                        Sign In
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="admin-btn-secondary">
                        Return Home
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}