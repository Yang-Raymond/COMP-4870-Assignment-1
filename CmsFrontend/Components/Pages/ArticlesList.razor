@page "/articles"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Articles – Mini-CMS</PageTitle>

<div class="space-y-6">
    <div class="card card-pad">
        <div class="flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl font-extrabold tracking-tight" style="margin:0">Articles</h2>
                <p class="text-muted" style="margin-top:.25rem">
                    Browse posts fetched from the ASP.NET REST API.
                </p>
            </div>
            <div class="badge">@filtered.Count shown</div>
        </div>

        <div class="mt-4">
            <input class="input"
                   placeholder="Search by title/author ID…"
                   @bind="query"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (loading)
    {
        <p>Loading articles…</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <p class="text-red-600">Error: @error</p>
    }
    else if (filtered.Count == 0)
    {
        <div class="card card-pad">No articles found.</div>
    }
    else
    {
        <div class="articles-list-grid">
            @foreach (var a in filtered)
            {
                <div class="card card-pad">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-extrabold" style="margin:0">@a.Title</h3>
                            <div class="text-sm text-muted" style="margin-top:.5rem">
                                By <span class="font-semibold" style="color:var(--text)">@(string.IsNullOrEmpty(a.AuthorId) ? "unknown" : a.AuthorId)</span>
                                • @a.CreatedAtUtc.ToLocalTime().ToString("g")
                            </div>
                        </div>
                        <a href="articles/@a.Id" class="btn-primary-sm">Read →</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<BlazorFrontEnd.Models.Article> articles = new();
    private bool loading = true;
    private string? error;
    private string query = "";

    private List<BlazorFrontEnd.Models.Article> filtered =>
        string.IsNullOrWhiteSpace(query)
            ? articles
            : articles.Where(a =>
                (a.Title?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.AuthorId?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("CmsApi");
            var data = await client.GetFromJsonAsync<List<BlazorFrontEnd.Models.Article>>("/api/articles");
            if (data is not null)
                articles = data;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}