@page "/not-found"

<PageTitle>404 – Mini-CMS</PageTitle>

<div class="not-found-wrapper">
    <div class="not-found-big">404</div>

    <div class="not-found-scene">
        <img style="width:100%;position:relative;z-index:10" src="/images/mountains.png" alt="Mountains" />
        <img style="position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);width:8rem;z-index:20;filter:drop-shadow(0 6px 12px rgba(0,0,0,.15))"
             src="/images/penguin.png" alt="Penguin" />
    </div>

    <div style="z-index:20;position:relative;text-align:center;padding:0 1.5rem;margin-top:3rem">
        <h2 class="text-3xl font-bold tracking-tight">Page Not Found</h2>
        <p class="text-lg text-muted" style="margin-top:1rem;max-width:28rem;margin-left:auto;margin-right:auto;line-height:1.625">
            Oops! The page you are looking for might have been removed, had its
            name changed, or is temporarily unavailable.
        </p>
        <div class="mt-8">
            <a href="/" class="btn-primary" style="padding:.75rem 2rem;font-size:1.125rem">
                Back to Home
            </a>
        </div>
    </div>
</div>