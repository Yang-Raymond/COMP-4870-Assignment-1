@page "/articles/{Id:int}"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@using System.Threading.Tasks
@using Google.GenAI
@using Google.GenAI.Types

<PageTitle>@(article?.Title ?? "Article") – Mini-CMS</PageTitle>

@if (loading)
{
    <div class="text-center text-muted" style="padding:2rem">Loading article...</div>
}
else if (article is null)
{
    <div class="text-center text-muted" style="padding:2rem">Article not found.</div>
}
else
{
    <article class="article-detail">
        <div class="flex justify-between items-center mb-8">
            <a href="/articles" class="btn-ghost">← Back to articles</a>
        </div>

        <header class="article-detail-header">
            <h1 class="text-4xl font-bold tracking-tight leading-tight" style="margin-bottom:1rem">
                @article.Title
            </h1>

            <div class="flex items-center text-sm text-muted">
                <span class="font-semibold" style="color:var(--text)">
                    @GetAuthorDisplayName(article)
                </span>
                <span style="margin:0 .5rem">•</span>
                <time datetime="@article.CreatedAtUtc.ToString("o")">
                    @article.CreatedAtUtc.ToLocalTime().ToString("MMMM d, yyyy")
                </time>
            </div>
        </header>

        <div class="ai-overview-section">
        @if(!string.IsNullOrEmpty(error)){
            <div class="error-box mt-6" style="overflow-wrap: break-word;">@error</div>
        }
        else{
            <div class="ai-overview-top">
                <span class="ai-overview-pill">AI</span>

                <button class="ai-overview-button" @onclick="ToggleOverview">
                    @(showOverview ? "Hide AI Overview" : "Show AI Overview")
                </button>
            </div>

            @if (showOverview)
            {
                <div class="ai-overview-card">
                    <div class="ai-overview-title">AI Overview</div>

                    @if (!string.IsNullOrWhiteSpace(summary))
                    {
                        <p class="ai-overview-text">@summary</p>
                    }
                    else
                    {
                        <p class="ai-overview-text ai-overview-empty">
                            No AI overview available yet.
                        </p>
                    }
                </div>
            }
        }
        </div>

        <div class="rich-text-content leading-relaxed text-lg space-y-4">
            @((MarkupString)article.ContentHtml)
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BlazorFrontEnd.Models.Article? article;
    private string? summary;
    private bool loading = true;
    private string? error;

    private bool showOverview = false;

    private void ToggleOverview()
    {
        showOverview = !showOverview;
    }

    private static string GetAuthorDisplayName(BlazorFrontEnd.Models.Article value)
        => !string.IsNullOrWhiteSpace(value.AuthorName)
            ? value.AuthorName
            : (!string.IsNullOrWhiteSpace(value.AuthorId) ? value.AuthorId : "Anonymous");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("CmsApi");
            article = await client.GetFromJsonAsync<BlazorFrontEnd.Models.Article>($"/api/articles/{Id}");

            var apiKey = Configuration["GEMINI_API_KEY"];
            Console.WriteLine(apiKey);
            var geminiClient = new Client(apiKey: apiKey);
            var response = await geminiClient.Models.GenerateContentAsync(
              model: "gemini-3.1-flash-lite-preview", contents: $"Summarize this article: {article.ContentHtml}"
            );
            summary = response.Text;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}